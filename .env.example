# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (optional - defaults to SQLite)
# DATABASE_URL=postgres://user:pass@localhost:5432/watch_tracker

# xAI Grok AI — Get free API key at https://console.x.ai/
XAI_API_KEY=your-xai-api-key
XAI_MODEL=grok-3

# TMDB (The Movie Database) — Get free API key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your-tmdb-api-key

# Optional: Cache timeout for recommendations (seconds)
RECOMMEND_CACHE_TIMEOUT=300

# CSRF/Security (for production)
# CSRF_COOKIE_SECURE=True
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com